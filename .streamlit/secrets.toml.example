# ---------------------------------------------------------------------
#  TTT-LLL secrets.
#
#  Copy to .streamlit/secrets.toml for local runs (that file is
#  gitignored). On Streamlit Community Cloud, paste the real version into
#  Settings -> Secrets instead — never commit real keys to the repo.
#
#  THE NAMES HERE MATCH apps_script/TTT_LLL_Complete.gs LETTER FOR
#  LETTER, on purpose. The same thing must never be called one name here
#  and another there; a person setting this up should be able to read a
#  name and search for it in the other file and find it.
#  If you rename anything, rename it in BOTH.
# ---------------------------------------------------------------------


# --- the spreadsheet ---------------------------------------------------

# The /exec address the Apps Script gives you after
# Deploy > Manage deployments > New version.
SHEETS_URL = "https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT/exec"

# MUST EQUAL var SHEETS_TOKEN in the Apps Script. Nothing works until the
# two match, and a mismatch answers "bad token" rather than saying so.
# Make it with:  openssl rand -base64 33
SHEETS_TOKEN = "change-me-to-a-long-random-string"


# --- Drive audio storage (optional) ------------------------------------

# MUST EQUAL var DRIVE_SECRET in the Apps Script, and must be DIFFERENT
# from SHEETS_TOKEN. That token unlocks the settings and every API key;
# this one only signs short-lived download links, so losing one must
# never cost the other. setupDrive() refuses to run if they are the same.
DRIVE_SECRET = "change-me-to-a-DIFFERENT-long-random-string"


# --- who can get in ----------------------------------------------------

# Any number of passwords — one per person you share the app with.
APP_PASSWORDS = [
    "change-me-one",
    "change-me-two",
]

# Which of them sees the admin module and the log. One username.
ADMIN_USER = "change-me"


# --- engines -----------------------------------------------------------

# Several keys so a rate-limited one can rest while another works.
# These can also live in the k_groq tab of the spreadsheet instead.
GROQ_API_KEYS = [
    "gsk_key_one",
    "gsk_key_two",
]
